{
    "name": "libxa/socket",
    "description": "A Pusher-protocol WebSocket server for LibxaFrame, built on ReactPHP. Works with existing Pusher clients unchanged.",
    "type": "library",
    "license": "MIT",
    "keywords": ["libxa", "libxaframe", "websocket", "realtime", "pusher", "echo", "reactphp", "broadcasting"],
    "require": {
        "php": "^8.3",
        "libxa/framework": "^0.11.2",
        "symfony/console": "^7.0",
        "react/socket": "^1.14",
        "react/promise-timer": "^1.10",
        "ratchet/rfc6455": "^0.4",
        "guzzlehttp/psr7": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "LibxaSocket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibxaSocket\\Tests\\": "tests/"
        }
    },
    "extra": {
        "Libxa": {
            "providers": [
                "LibxaSocket\\SocketServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "lint": "@php -r \"foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator('src')) as $f) { if ($f->getExtension() === 'php') { passthru(escapeshellarg(PHP_BINARY) . ' -l ' . escapeshellarg($f->getPathname()), $c); if ($c !== 0) { exit(1); } } } echo 'ok', PHP_EOL;\""
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
